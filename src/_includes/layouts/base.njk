{#- The frame around every page: <head>, header, footer. -#}
{%- set isHome = page.url == "/" -%}
{%- set pageTitle = site.program_name + " | " + site.tagline if isHome else title + " | " + site.program_name -%}
{%- set pageDescription = description or site.tagline -%}
<!doctype html>
<html lang="en" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  {%- if site.prototype %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
  {%- if site.website_address %}
  <link rel="canonical" href="{{ site.website_address }}{{ page.url }}">
  <meta property="og:url" content="{{ site.website_address }}{{ page.url }}">
  <meta property="og:image" content="{{ site.website_address }}/og-image.png">
  <meta property="og:image:alt" content="{{ site.program_name }}: {{ site.tagline }}">
  {%- endif %}
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.program_name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#061428">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="preload" href="/assets/fonts/barlow-condensed-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/public-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/site.css">
  <script>document.documentElement.classList.replace("no-js", "js");</script>
  <script src="/assets/js/site.js" defer></script>
  {%- if site.analytics_token %}
  {#- Cloudflare Web Analytics: no cookies, no personal information. -#}
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.analytics_token }}"}'></script>
  {%- endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  {%- if site.prototype %}
  <aside class="proto-banner" aria-label="Prototype notice"><strong>Prototype:</strong> this site is a draft awaiting approval and is not yet official.</aside>
  {%- endif %}
  {% include "partials/header.njk" %}
  <main id="main" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/icons.njk" %}
</body>
</html>
